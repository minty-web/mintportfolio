# Storage backend: "netlify" or "local". Defaults to Netlify Blobs when
# running on Netlify, otherwise a local JSON file (.data/projects.json).
# STORAGE="local"

# Single admin account (no public sign-up anywhere).
ADMIN_USERNAME="admin"
# Generate a hash with: npm run hash-password
ADMIN_PASSWORD_HASH="scrypt:16384:8:1:<salt_hex>:<derived_key_hex>"

# Secret used to sign the admin session cookie (base64url, min 32 bytes)
SESSION_SECRET=""

# How long an admin session lasts, in seconds (default 7 days)
# ADMIN_SESSION_TTL=604800

# Public URL of the site, used for canonical + OG meta tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: name shown in the header and meta tags (default "My Portfolio")
# NEXT_PUBLIC_SITE_NAME="My Portfolio"

# Optional: contact email shown in the footer (default "hello@example.com")
# NEXT_PUBLIC_SITE_EMAIL="hello@example.com"
